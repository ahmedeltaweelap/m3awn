        // إدارة القطاعات
        window.openSectorManager = async function() {
            if (!hasPerm('add')) return;
            const action = prompt(`القطاعات الحالية:\n${db.sectors.join(' - ')}\n\nاكتب اسم القطاع الجديد لإضافته (أو اكتب علامة ناقص - قبل اسم القطاع لحذفه):`);
            if (!action) return;
            const trimmed = action.trim();
            if (trimmed.startsWith('-')) {
                const toDel = trimmed.substring(1).trim();
                if (toDel === 'الكل') return alert("لا يمكن حذف قطاع الكل!");
                db.sectors = db.sectors.filter(s => s !== toDel);
                await persistState("حذف قطاع", "القطاعات", toDel);
            } else {
                if (!db.sectors.includes(trimmed)) {
                    db.sectors.push(trimmed);
                    await persistState("إضافة قطاع جديد", "القطاعات", trimmed);
                }
            }
