        // تسجيل عضو جديد
        window.submitMemberRegister = async function() {
            const name = document.getElementById('reg_name').value.trim();
            const title = document.getElementById('reg_title').value.trim() || "باحث قانوني";
            const username = document.getElementById('reg_username').value.trim().toLowerCase();
            const pin = document.getElementById('reg_pin').value.trim();

            if (!name || !username || !pin) return alert("يرجى ملء الاسم واسم المستخدم والرقم السري!");
            if (db.members.some(m => m.username.toLowerCase() === username)) {
                return alert("اسم المستخدم مسجل بالفعل، اختر اسم مستخدم آخر.");
            }

            const newMember = {
                id: "mem_" + Date.now(),
                name,
                title,
                username,
                pin,
                role: "member", // يبدأ كعضو عادي ويمكن للمدير ترقيته لمشرف
                perms: { add: false, edit: false, delete: false, approve: false, manageUsers: false },
                joinedAt: new Date().toLocaleDateString('ar-EG')
            };

            db.members.push(newMember);
            currentUser = newMember;
            await persistState("تسجيل عضو جديد", "بوابة الأعضاء", `انضمام العضو: ${name}`);
            toggleModal('memberAuthModal');
            alert(`تم إنشاء حسابك بنجاح يا ${name}!`);
        };

        // دخول عضو أو مشرف أو مدير
        window.submitMemberLogin = function() {
            const username = document.getElementById('login_username').value.trim().toLowerCase();
            const pin = document.getElementById('login_pin').value.trim();

            const found = db.members.find(m => (m.username.toLowerCase() === username || m.id === 'super_admin' && username === 'admin') && m.pin === pin);
            if (!found) return alert("بيانات الدخول غير صحيحة!");

            currentUser = found;
            toggleModal('memberAuthModal');
            RefreshAfterAuth();
        };

        // زر الإدارة السريع
        window.handleAdminClick = function() {
            if (currentUser && (currentUser.role === 'super_admin' || currentUser.role === 'moderator')) {
                toggleModal('adminModal');
                return;
            }
            const pin = prompt("للدخول السريع للوحة الإدارة، أدخل الرقم السري للمشرف أو المدير (الافتراضي للمدير: 1998):");
            if (!pin) return;
            const foundAdmin = db.members.find(m => m.pin === pin && (m.role === 'super_admin' || m.role === 'moderator'));
            if (foundAdmin) {
                currentUser = foundAdmin;
                RefreshAfterAuth();
                toggleModal('adminModal');
            } else {
                alert("الرقم السري غير صحيح أو أن حسابك لم تتم ترقيته لصلاحيات الإشراف بعد.");
            }
        };

