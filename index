        // ================= المزامنة الفورية مع السحابة (Firebase Realtime Sync) =================
        async function initCloudSync() {
            try {
                const snap = await getDoc(STATE_DOC_REF);
                if (!snap.exists()) {
                    await setDoc(STATE_DOC_REF, db);
                } else {
                    db = { ...initialPlatformState, ...snap.data() };
                }
                refreshAllUI();

                // الاستماع لأي تعديل يجريه أي مشرف أو عضو في نفس اللحظة
                onSnapshot(STATE_DOC_REF, (docSnap) => {
                    if (docSnap.exists()) {
                        db = { ...initialPlatformState, ...docSnap.data() };
                        refreshAllUI();
                    }
                });
            } catch (err) {
                console.error("Cloud sync warning:", err);
                const savedLocal = localStorage.getItem("moawen_backup_state");
                if (savedLocal) db = JSON.parse(savedLocal);
                refreshAllUI();
            }
        }

        async function persistState(actionName = null, sectionName = null, itemTitle = null) {
            if (actionName && currentUser) {
                db.auditLogs.unshift({
                    id: "log_" + Date.now(),
                    time: new Date().toLocaleString('ar-EG'),
                    actor: `${currentUser.name} (${currentUser.username})`,
                    action: actionName,
                    section: sectionName || "-",
                    details: itemTitle || "-"
                });
            }
            localStorage.setItem("moawen_backup_state", JSON.stringify(db));
            refreshAllUI();
            try {
                await setDoc(STATE_DOC_REF, db);
            } catch (e) {
                console.error("Error writing to Firebase:", e);
            }
        }

        // ================= صلاحيات المستخدمين والأعضاء والمشرفين =================
        function hasPerm(permKey) {
            if (!currentUser) return false;
            if (currentUser.role === 'super_admin') return true;
            if (currentUser.role === 'moderator' && currentUser.perms && currentUser.perms[permKey]) return true;
            return false;
        }

        function updateAuthUI() {
            const statusBar = document.getElementById('userStatusBar');
            const roleBadge = document.getElementById('activeRoleBadge');
            const nameEl = document.getElementById('activeUserName');
            const titleEl = document.getElementById('activeUserTitle');
            const permsEl = document.getElementById('activeUserPerms');
            const openDashBtn = document.getElementById('openAdminDashBtn');
            const memberTopText = document.getElementById('memberTopText');

            if (!currentUser) {
                statusBar.classList.add('hidden');
                memberTopText.innerText = "تسجيل / دخول الأعضاء";
                document.querySelectorAll('.admin-add-btn, .admin-edit-btn, .admin-del-btn, .admin-action-btn').forEach(el => el.classList.add('hidden'));
                return;
            }

            statusBar.classList.remove('hidden');
            nameEl.innerText = currentUser.name;
            titleEl.innerText = currentUser.title || "عضو مسجل";
            memberTopText.innerText = currentUser.name;

            if (currentUser.role === 'super_admin') {
                roleBadge.innerText = "👑 المدير العام للمنصة";
                permsEl.innerText = "| كافة الصلاحيات مفعّلة";
                openDashBtn.classList.remove('hidden');
            } else if (currentUser.role === 'moderator') {
                roleBadge.innerText = "🛡️ مشرف معتمد";
                const pList = [];
                if (hasPerm('add')) pList.push('إضافة');
                if (hasPerm('edit')) pList.push('تعديل');
                if (hasPerm('delete')) pList.push('حذف');
                if (hasPerm('approve')) pList.push('اعتماد مساهمات');
                if (hasPerm('manageUsers')) pList.push('إدارة أعضاء');
                permsEl.innerText = `| الصلاحيات: (${pList.join(' - ')})`;
                openDashBtn.classList.remove('hidden');
            } else {
                roleBadge.innerText = "👤 عضو مسجل";
                permsEl.innerText = "| يمكنك إرسال المساهمات باسمك وتجميع المسودات";
                openDashBtn.classList.add('hidden');
