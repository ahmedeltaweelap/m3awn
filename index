                    </div>
                    <p class="text-xs text-slate-700 bg-white p-3 rounded border whitespace-pre-line">${p.content}</p>
                    <div class="flex justify-between items-center text-[11px] text-slate-500">
                        <span>السند: ${p.ref} | بتاريخ: ${p.date}</span>
                        ${hasPerm('approve') ? `
                            <div class="flex gap-2">
                                <button onclick="approveContribution('${p.id}')" class="bg-emerald-600 text-white font-bold px-3 py-1 rounded">اعتماد ونشر</button>
                                <button onclick="rejectContribution('${p.id}')" class="bg-red-600 text-white font-bold px-3 py-1 rounded">حذف</button>
                            </div>
                        ` : ''}
                    </div>
                </div>
            `).join('');
        }

        window.approveContribution = async function(id) {
            if (!hasPerm('approve')) return;
            const item = db.pendingContributions.find(p => p.id === id);
            if (!item) return;
            db.defenses.unshift({
                id: "def_" + Date.now(),
                sector: item.sector,
                category: "مساهمة معتمدة",
                title: item.title,
                response: item.content,
                ref: item.ref,
                contributor: item.contributor
            });
            db.pendingContributions = db.pendingContributions.filter(p => p.id !== id);
            await persistState("اعتماد مساهمة عضو", "بنك الحيثيات", item.title);
        };

        window.rejectContribution = async function(id) {
            if (!hasPerm('approve')) return;
            db.pendingContributions = db.pendingContributions.filter(p => p.id !== id);
            await persistState("رفض مساهمة", "المساهمات", id);
        };

        // ================= عرض الأقسام الخمسة في الواجهة =================
        function filterByCurrentSector(list) {
            if (currentSector === "الكل") return list;
            return list.filter(item => item.sector === currentSector || item.sector === "الكل");
        }

        function renderSectorsBar() {
            const bar = document.getElementById('sectorsBar');
            bar.innerHTML = `<span class="font-bold text-slate-500 ml-1 text-xs whitespace-nowrap"><i class="fa-solid fa-layer-group text-judicial-gold ml-1"></i> القطاع:</span>` +
                db.sectors.map(sec => `
                    <button onclick="selectSector('${sec}')" class="px-3.5 py-1 rounded-full text-xs border transition whitespace-nowrap ${currentSector === sec ? 'sector-active' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}">
                        ${sec}
                    </button>
                `).join('');
        }

        window.selectSector = function(sec) {
            currentSector = sec;
            refreshAllUI();
        };

        function renderJurisdictions() {
            const list = filterByCurrentSector(db.jurisdictions);
            const container = document.getElementById('jurisdictionContainer');
            const canEdit = hasPerm('edit');
            const canDel = hasPerm('delete');

            container.innerHTML = list.map(j => `
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between searchable-card">
                    <div>
                        <div class="flex justify-between items-start gap-2 mb-2 border-b pb-2">
                            <span class="bg-judicial-900 text-judicial-gold text-[11px] font-bold px-2.5 py-0.5 rounded">${j.category}</span>
                            <div class="flex gap-1">
                                ${canEdit ? `<button onclick="openItemEditor('jurisdiction', '${j.id}')" class="text-amber-600 hover:bg-amber-50 px-2 py-0.5 rounded text-xs"><i class="fa-solid fa-pen"></i></button>` : ''}
                                ${canDel ? `<button onclick="deleteItem('jurisdiction', '${j.id}')" class="text-red-600 hover:bg-red-50 px-2 py-0.5 rounded text-xs"><i class="fa-solid fa-trash"></i></button>` : ''}
                            </div>
                        </div>
                        <h3 class="font-bold text-judicial-900 text-sm mb-2">${j.title}</h3>
                        <p class="text-xs text-slate-700 leading-relaxed bg-slate-50 p-3 rounded-lg border">${j.content}</p>
                    </div>
                    <div class="mt-3 pt-2 border-t flex justify-between items-center text-[11px] text-slate-500">
                        <span><i class="fa-solid fa-book-bible text-judicial-gold ml-1"></i> ${j.ref}</span>
                        <button onclick="addToBasket('${j.title}', \`${j.content}\`)" class="text-judicial-900 font-bold hover:underline">+ للمسودة</button>
                    </div>
                </div>
            `).join('');
        }

        function renderChecklistsSection() {
            const list = filterByCurrentSector(db.checklists);
            const sel = document.getElementById('checklistSelector');
            const prevVal = sel.value;
            sel.innerHTML = list.length ? list.map(c => `<option value="${c.id}">[${c.sector}] ${c.title}</option>`).join('') : `<option value="">لا توجد قوائم في هذا القطاع</option>`;
            if (list.some(c => c.id === prevVal)) sel.value = prevVal;
            renderSelectedChecklist();
        }

        window.renderSelectedChecklist = function() {
            const id = document.getElementById('checklistSelector').value;
            const data = db.checklists.find(c => c.id === id);
            const container = document.getElementById('checklistContainer');
            if (!data) {
                container.innerHTML = `<div class="col-span-2 bg-white p-8 rounded-xl text-center text-slate-400 text-xs">لا توجد قوائم مضافة في هذا القطاع حالياً.</div>`;
                return;
            }
            container.innerHTML = `
                <div class="bg-white p-5 rounded-xl shadow-sm border-t-4 border-judicial-900">
                    <h3 class="font-bold text-judicial-900 text-sm mb-3"><i class="fa-solid fa-folder-open text-judicial-gold ml-1"></i> أولاً: المستندات والأوراق الجوهرية</h3>
                    <div class="space-y-2">${data.docs.map(d => `<label class="flex items-start gap-2.5 p-2 rounded hover:bg-slate-50 cursor-pointer text-xs"><input type="checkbox" onchange="updateProgress()" class="chk-item mt-0.5 w-4 h-4 accent-judicial-900"><span>${d}</span></label>`).join('')}</div>
                </div>
                <div class="bg-white p-5 rounded-xl shadow-sm border-t-4 border-blue-700">
                    <h3 class="font-bold text-judicial-900 text-sm mb-3"><i class="fa-solid fa-users text-blue-700 ml-1"></i> ثانياً: الأسئلة الاسترشادية للشهود والمختصين</h3>
                    <div class="space-y-2">${data.witness_q.map(q => `<label class="flex items-start gap-2.5 p-2 rounded hover:bg-slate-50 cursor-pointer text-xs font-semibold"><input type="checkbox" onchange="updateProgress()" class="chk-item mt-0.5 w-4 h-4 accent-judicial-900"><span>"${q}"</span></label>`).join('')}</div>
                </div>
                <div class="bg-white p-5 rounded-xl shadow-sm border-t-4 border-red-700">
                    <h3 class="font-bold text-judicial-900 text-sm mb-3"><i class="fa-solid fa-gavel text-red-700 ml-1"></i> ثالثاً: أسئلة المواجهة والمساءلة</h3>
                    <div class="space-y-2">${data.accused_q.map(q => `<label class="flex items-start gap-2.5 p-2 rounded hover:bg-slate-50 cursor-pointer text-xs font-semibold"><input type="checkbox" onchange="updateProgress()" class="chk-item mt-0.5 w-4 h-4 accent-judicial-900"><span>"${q}"</span></label>`).join('')}</div>
                </div>
                <div class="bg-amber-50 p-5 rounded-xl shadow-sm border-t-4 border-judicial-gold">
                    <h3 class="font-bold text-judicial-900 text-sm mb-3"><i class="fa-solid fa-lightbulb text-judicial-gold ml-1"></i> رابعاً: ضوابط وتريكات فنية</h3>
                    <ul class="space-y-2 list-disc list-inside text-xs text-slate-800">${data.tips.map(t => `<li class="p-2 bg-white rounded border border-amber-200">${t}</li>`).join('')}</ul>
                </div>
            `;
            updateProgress();
        };

        function renderQaydsSection() {
            const list = filterByCurrentSector(db.qayds);
            const sel = document.getElementById('qaydSelector');
            const prevVal = sel.value;
            sel.innerHTML = list.length ? list.map(q => `<option value="${q.id}">[${q.sector}] ${q.title}</option>`).join('') : `<option value="">لا توجد قوالب في هذا القطاع</option>`;
            if (list.some(q => q.id === prevVal)) sel.value = prevVal;
            generateQayd();
        }

        window.generateQayd = function() {
            const id = document.getElementById('qaydSelector').value;
            const qObj = db.qayds.find(q => q.id === id);
            if (!qObj) {
                document.getElementById('qaydOutput').innerText = "لا يوجد قالب محدد في هذا القطاع.";
                return;
            }
            const name = document.getElementById('q_name').value || ".................... (الاسم والصفة والدرجة)";
            const date = document.getElementById('q_date').value || "عامي .... / ....";
            const prop = document.getElementById('q_property').value || ".................... (بيان الواقعة/الجهة)";

            const finalWasf = qObj.wasf
                .replace(/{{الاسم}}/g, name)
                .replace(/{{التاريخ}}/g, date)
                .replace(/{{الواقعة}}/g, prop);

            document.getElementById('qaydSectorBadge').innerText = qObj.sector;
            document.getElementById('qaydOutput').innerText = `【 الـوصـف والـقـيـد الـقـانـونـي 】\n\n${finalWasf}\n\n${qObj.articles}`;
        };

        function renderDefensesSection() {
            const list = filterByCurrentSector(db.defenses);
            const container = document.getElementById('defensesContainer');
            const canEdit = hasPerm('edit');
            const canDel = hasPerm('delete');

            container.innerHTML = list.map((d, index) => `
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 hover:border-judicial-gold transition searchable-card">
                    <div class="flex flex-wrap justify-between items-start gap-2 mb-3 border-b pb-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="bg-judicial-900 text-judicial-gold text-[11px] font-bold px-2.5 py-0.5 rounded">${d.category || 'مبدأ قانوني'}</span>
                            <span class="bg-slate-100 text-slate-700 text-[11px] font-bold px-2 py-0.5 rounded">${d.sector}</span>
                            <h3 class="font-bold text-judicial-900 text-sm">${d.title}</h3>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="bg-amber-50 border border-judicial-gold/60 text-judicial-900 text-[11px] font-bold px-2.5 py-0.5 rounded-full">
                                <i class="fa-solid fa-feather-pointed text-judicial-gold ml-1"></i> ${d.contributor}
                            </span>
                            ${canEdit ? `<button onclick="openItemEditor('defense', '${d.id}')" class="bg-amber-100 text-amber-800 hover:bg-amber-500 hover:text-white px-2 py-1 rounded text-xs transition"><i class="fa-solid fa-pen"></i> تعديل</button>` : ''}
                            ${canDel ? `<button onclick="deleteItem('defense', '${d.id}')" class="bg-red-100 text-red-600 hover:bg-red-600 hover:text-white px-2 py-1 rounded text-xs transition"><i class="fa-solid fa-trash"></i></button>` : ''}
                        </div>
                    </div>
                    <p id="def-text-${index}" class="text-slate-800 font-serif text-lg leading-relaxed bg-slate-50 p-4 rounded-lg border border-slate-200 mb-3 whitespace-pre-line">${d.response}</p>
                    <div class="flex flex-wrap justify-between items-center gap-2 text-xs text-slate-500">
                        <span><i class="fa-solid fa-scale-unbalanced ml-1 text-judicial-gold"></i> السند: ${d.ref}</span>
                        <div class="flex gap-2">
                            <button onclick="copyText('def-text-${index}')" class="bg-judicial-900 hover:bg-judicial-800 text-white px-3 py-1.5 rounded-lg font-bold text-xs">
                                <i class="fa-regular fa-copy ml-1 text-judicial-gold"></i> نسخ النص
                            </button>
                            <button onclick="addToBasket('${d.title}', document.getElementById('def-text-${index}').innerText)" class="bg-judicial-gold hover:bg-yellow-500 text-judicial-950 px-3 py-1.5 rounded-lg font-extrabold text-xs">
                                <i class="fa-solid fa-plus ml-1"></i> أضف للمسودة
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function renderRegulationsSection() {
            const list = filterByCurrentSector(db.regulations);
            const container = document.getElementById('regulationsContainer');
            const canEdit = hasPerm('edit');
            const canDel = hasPerm('delete');

            container.innerHTML = list.map((r, idx) => `
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between searchable-card">
                    <div>
                        <div class="border-b pb-2 mb-3 flex justify-between items-start">
                            <div>
                                <span class="text-[11px] font-bold text-judicial-gold bg-judicial-900 px-2.5 py-0.5 rounded">${r.number}</span>
                                <h3 class="font-bold text-judicial-900 text-sm mt-2">${r.title}</h3>
                            </div>
                            <div class="flex gap-1">
                                ${canEdit ? `<button onclick="openItemEditor('regulation', '${r.id}')" class="text-amber-600 hover:bg-amber-50 px-2 py-1 rounded text-xs"><i class="fa-solid fa-pen"></i></button>` : ''}
                                ${canDel ? `<button onclick="deleteItem('regulation', '${r.id}')" class="text-red-600 hover:bg-red-50 px-2 py-1 rounded text-xs"><i class="fa-solid fa-trash"></i></button>` : ''}
                            </div>
                        </div>
                        <div id="reg-text-${idx}" class="space-y-2 text-xs text-slate-700 leading-relaxed">
                            ${r.articles.map(a => `<p class="p-2.5 bg-slate-50 rounded border border-slate-100">${a}</p>`).join('')}
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t flex justify-end gap-2">
                        <button onclick="addToBasket('${r.title}', document.getElementById('reg-text-${idx}').innerText)" class="bg-judicial-gold hover:bg-yellow-500 text-judicial-950 text-xs font-extrabold px-3 py-1.5 rounded-lg">
                            <i class="fa-solid fa-plus ml-1"></i> إرفاق بالمسودة
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // ================= سجل الرقابة والتعديلات (Audit Logs) =================
        window.renderAuditLogs = function() {
            const q = (document.getElementById('logSearchInput')?.value || "").toLowerCase();
            const tbody = document.getElementById('auditLogsTableBody');
            const filtered = db.auditLogs.filter(l => 
                l.actor.toLowerCase().includes(q) || 
                l.action.toLowerCase().includes(q) || 
                l.details.toLowerCase().includes(q)
            );

            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">لا توجد حركات مسجلة حتى الآن.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(l => `
                <tr class="hover:bg-slate-50">
                    <td class="p-2.5 text-slate-500 whitespace-nowrap">${l.time}</td>
                    <td class="p-2.5 font-bold text-judicial-900">${l.actor}</td>
                    <td class="p-2.5"><span class="bg-slate-100 text-slate-800 px-2 py-0.5 rounded font-bold">${l.action}</span></td>
                    <td class="p-2.5 text-slate-600">${l.section}</td>
                    <td class="p-2.5 text-slate-700">${l.details}</td>
                </tr>
            `).join('');
        };

        window.exportLogsCSV = function() {
            if (!db.auditLogs.length) return alert("السجل فارغ!");
            const rows = [["التاريخ والوقت", "المسؤول", "نوع العملية", "القسم", "التفاصيل"]];
            db.auditLogs.forEach(l => rows.push([l.time, l.actor, l.action, l.section, l.details]));
            const csvContent = "data:text/csv;charset=utf-8,\uFEFF" + rows.map(e => e.join(",")).join("\n");
            const link = document.createElement("a");
            link.setAttribute("href", encodeURI(csvContent));
            link.setAttribute("download", "audit_logs.csv");
            document.body.appendChild(link);
            link.click();
            link.remove();
        };

        // ================= دوال مساعدة وتنقل =================
        function refreshAllUI() {
            updateAuthUI();
            renderSectorsBar();
            renderJurisdictions();
            renderChecklistsSection();
            renderQaydsSection();
            renderDefensesSection();
            renderRegulationsSection();
            renderMembersTable();
            renderPendingContributions();
            renderAuditLogs();
        }

        window.switchTab = function(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('tab-active'));
            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById('btn-' + tabId).classList.add('tab-active');
        };

        window.switchAdminView = function(viewId) {
            document.querySelectorAll('.adm-view').forEach(v => v.classList.add('hidden'));
            document.querySelectorAll('.adm-nav-btn').forEach(b => b.classList.remove('adm-nav-active'));
            document.getElementById(viewId).classList.remove('hidden');
            const btnId = 'admBtn-' + viewId.replace('adm-', '');
            document.getElementById(btnId)?.classList.add('adm-nav-active');
        };

        window.toggleModal = function(id) {
            document.getElementById(id).classList.toggle('hidden');
        };

        window.updateProgress = function() {
            const all = document.querySelectorAll('.chk-item');
            const checked = document.querySelectorAll('.chk-item:checked');
            const percent = all.length ? Math.round((checked.length / all.length) * 100) : 0;
            document.getElementById('progressBar').style.width = percent + '%';
            document.getElementById('progressText').innerText = percent + '%';
        };

        window.resetCheckboxes = function() {
            document.querySelectorAll('.chk-item').forEach(c => c.checked = false);
            updateProgress();
        };

        window.addToBasket = function(title, content) {
            basket.push({ title, content });
            document.getElementById('basketCount').innerText = basket.length;
            renderBasket();
            alert("تمت الإضافة للمسودة!");
        };

        function renderBasket() {
            const container = document.getElementById('basketItems');
            if (!basket.length) {
                container.innerHTML = `<p class="text-center text-slate-400 text-xs py-6">المسودة فارغة حالياً.</p>`;
                return;
            }
            container.innerHTML = basket.map((b, i) => `
                <div class="p-4 bg-slate-50 rounded-xl border relative">
                    <button onclick="removeFromBasket(${i})" class="absolute left-3 top-3 text-red-500 text-xs font-bold">حذف</button>
                    <span class="bg-judicial-900 text-judicial-gold text-xs font-bold px-2.5 py-0.5 rounded">${b.title}</span>
                    <p class="mt-2 text-sm font-serif whitespace-pre-line">${b.content}</p>
                </div>
            `).join('');
        }

        window.removeFromBasket = function(i) {
            basket.splice(i, 1);
            document.getElementById('basketCount').innerText = basket.length;
            renderBasket();
        };

        window.clearBasket = function() {
            basket = [];
            document.getElementById('basketCount').innerText = 0;
            renderBasket();
        };

        window.copyAllBasket = function() {
            if (!basket.length) return;
            navigator.clipboard.writeText(basket.map(b => `--- [ ${b.title} ] ---\n${b.content}`).join('\n\n'));
            alert("تم نسخ المسودة بالكامل!");
        };

        window.copyText = function(id) {
            navigator.clipboard.writeText(document.getElementById(id).innerText);
            alert("تم نسخ النص!");
        };

        window.handleGlobalSearch = function() {
            const q = document.getElementById('globalSearch').value.toLowerCase();
            document.querySelectorAll('.searchable-card').forEach(card => {
                card.style.display = card.innerText.toLowerCase().includes(q) ? 'flex' : 'none';
            });
        };

        // بدء التشغيل والمزامنة السحابية
        window.addEventListener('DOMContentLoaded', () => {
            renderBasket();
            initCloudSync();
        });
    </script>
</body>
</html>
