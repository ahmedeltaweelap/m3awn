        window.saveMemberPromotion = async function(memberId) {
            if (!hasPerm('manageUsers')) return alert("ليست لديك صلاحية إدارة الأعضاء!");
            const mem = db.members.find(m => m.id === memberId);
            if (!mem) return;

            const newRole = document.getElementById(`role_${memberId}`).value;
            const perms = {
                add: document.getElementById(`perm_add_${memberId}`).checked,
                edit: document.getElementById(`perm_edit_${memberId}`).checked,
                delete: document.getElementById(`perm_del_${memberId}`).checked,
                approve: document.getElementById(`perm_app_${memberId}`).checked,
                manageUsers: document.getElementById(`perm_usr_${memberId}`).checked
            };

            // إذا منح أي صلاحية، نرقيه تلقائياً لمشرف
            if (Object.values(perms).some(Boolean) && newRole === 'member') {
                mem.role = 'moderator';
            } else {
                mem.role = newRole;
            }
            mem.perms = perms;

            await persistState("ترقية وتعديل صلاحيات عضو", "إدارة الأعضاء", `تحديث رتبة وصلاحيات: ${mem.name}`);
            alert(`تم حفظ صلاحيات (${mem.name}) بنجاح!`);
        };

        window.deleteMember = async function(memberId) {
            if (!hasPerm('manageUsers')) return;
            const mem = db.members.find(m => m.id === memberId);
            if (!mem || !confirm(`هل أنت متأكد من حذف حساب العضو (${mem.name})؟`)) return;
            db.members = db.members.filter(m => m.id !== memberId);
            await persistState("حذف عضو", "إدارة الأعضاء", `حذف العضو: ${mem.name}`);
        };

