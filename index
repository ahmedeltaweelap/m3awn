<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المُـعَـاوِن | الموسوعة البحثية في القانون الإداري والتأديبي</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cairo & Amiri -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        judicial: {
                            950: '#060B19',
                            900: '#0B132B',
                            800: '#1C2541',
                            700: '#2A365F',
                            gold: '#C5A059',
                            goldLight: '#F9F3E5',
                        }
                    },
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                        serif: ['Amiri', 'serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #F1F5F9; }
        .tab-active {
            background-color: #0B132B !important;
            color: #C5A059 !important;
            border-bottom: 4px solid #C5A059 !important;
        }
        .sector-active {
            background-color: #0B132B !important;
            color: #C5A059 !important;
            font-weight: 700;
            border-color: #C5A059 !important;
        }
        .adm-nav-active {
            background-color: #0B132B !important;
            color: #C5A059 !important;
        }
        .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5A059; border-radius: 4px; }
    </style>
</head>
<body class="font-sans text-slate-800 pb-24">

    <!-- 1. الهيدر الرئيسي (يضم نافذة تسجيل الأعضاء + المساهمات + المسودة + الإدارة) -->
    <header class="bg-judicial-900 text-white shadow-xl sticky top-0 z-40 border-b-2 border-judicial-gold">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-3">
            
            <!-- الشعار والاسم -->
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-judicial-800 border-2 border-judicial-gold flex items-center justify-center text-judicial-gold text-xl shadow-lg">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-serif text-2xl tracking-wide text-judicial-gold">المُـعَـاوِن</h1>
                        <span id="cloudStatusBadge" class="bg-emerald-900/80 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> متصل سحابياً
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-300">الموسوعة البحثية المتكاملة في القانون الإداري والتأديبي</p>
                </div>
            </div>

            <!-- شريط البحث الشامل -->
            <div class="flex-1 max-w-sm mx-2 hidden lg:block">
                <div class="relative">
                    <input type="text" id="globalSearch" oninput="handleGlobalSearch()" placeholder="ابحث في الحيثيات، الدفوع، القوانين، اللوائح..." 
                           class="w-full bg-judicial-800 text-white placeholder-slate-400 rounded-lg py-1.5 pr-9 pl-3 border border-slate-600 focus:outline-none focus:border-judicial-gold text-xs">
                    <i class="fa-solid fa-magnifying-glass absolute right-3 top-2.5 text-judicial-gold text-xs"></i>
                </div>
            </div>

            <!-- الأزرار العلوية المنفصلة (تسجيل العضو + شارك مساهمة + مسودة + الإدارة) -->
            <div class="flex items-center gap-2 flex-wrap">
                
                <!-- 1. زر تسجيل ودخول الأعضاء (منفصل) -->
                <button onclick="openMemberAuthModal()" id="memberTopBtn" class="bg-judicial-800 hover:bg-judicial-700 text-white px-3 py-1.5 rounded-lg border border-slate-500 text-xs font-bold flex items-center gap-1.5 transition shadow">
                    <i class="fa-solid fa-user-plus text-judicial-gold" id="memberTopIcon"></i>
                    <span id="memberTopText">تسجيل / دخول الأعضاء</span>
                </button>

                <!-- 2. زر إرسال مساهمة علمية (منفصل) -->
                <button onclick="openContributeModal()" class="bg-judicial-gold hover:bg-yellow-500 text-judicial-950 font-extrabold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1.5 transition shadow">
                    <i class="fa-solid fa-pen-nib"></i>
                    <span>إرسال مساهمة</span>
                </button>

                <!-- 3. زر مسودة المذكرة -->
                <button onclick="toggleModal('basketModal')" class="bg-judicial-800 hover:bg-judicial-700 text-white px-3 py-1.5 rounded-lg border border-judicial-gold/50 text-xs flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-briefcase text-judicial-gold"></i>
                    <span class="hidden sm:inline">المسودة</span>
                    <span id="basketCount" class="bg-judicial-gold text-judicial-950 font-extrabold text-[10px] px-1.5 py-0.5 rounded-full">0</span>
                </button>

                <!-- 4. زر لوحة الإدارة (للمشرفين والمدير) -->
                <button onclick="handleAdminClick()" id="adminTopBtn" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-1.5 rounded-lg border border-slate-600 text-xs font-bold flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-shield-halved text-judicial-gold" id="adminLockIcon"></i>
                    <span id="adminBtnText">الإدارة</span>
                </button>
            </div>
        </div>
    </header>

    <!-- شريط حالة العضو / المشرف النشط -->
    <div id="userStatusBar" class="hidden bg-gradient-to-r from-emerald-950 via-judicial-900 to-emerald-950 text-white px-4 py-2 text-xs border-b border-emerald-500/50 shadow-md">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
                <span id="activeRoleBadge" class="bg-emerald-500 text-emerald-950 font-extrabold px-2.5 py-0.5 rounded-full text-[11px]"></span>
                <span>مرحباً بك: <strong id="activeUserName" class="text-judicial-gold"></strong> (<span id="activeUserTitle" class="text-slate-300"></span>)</span>
                <span id="activeUserPerms" class="text-[11px] text-emerald-300 hidden md:inline"></span>
            </div>
            <div class="flex items-center gap-2">
                <button id="openAdminDashBtn" onclick="toggleModal('adminModal')" class="hidden bg-judicial-gold text-judicial-950 font-extrabold px-3 py-1 rounded shadow hover:bg-yellow-500 transition">
                    <i class="fa-solid fa-sliders ml-1"></i> فتح لوحة التحكم والتطوير
                </button>
                <button onclick="logoutUser()" class="bg-red-600/80 hover:bg-red-600 text-white font-bold px-2.5 py-1 rounded text-[11px] transition">
                    <i class="fa-solid fa-right-from-bracket ml-1"></i> تسجيل خروج
                </button>
            </div>
        </div>
    </div>

    <!-- 2. شريط القطاعات الديناميكي -->
    <div class="bg-white border-b shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-2.5 flex items-center justify-between gap-2">
            <div id="sectorsBar" class="flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5">
                <!-- يتم توليده ديناميكياً -->
            </div>
            <button onclick="openSectorManager()" class="admin-action-btn hidden bg-slate-800 hover:bg-slate-700 text-judicial-gold text-xs font-bold px-3 py-1.5 rounded-lg whitespace-nowrap flex items-center gap-1">
                <i class="fa-solid fa-folder-plus"></i> إدارة القطاعات
            </button>
        </div>
    </div>

    <!-- 3. الخريطة الإرشادية السريعة -->
    <section id="visualRoadmap" class="max-w-7xl mx-auto px-4 mt-5">
        <div class="bg-gradient-to-l from-judicial-950 via-judicial-900 to-judicial-800 rounded-2xl p-4 text-white shadow-lg border border-judicial-gold/60">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                <div onclick="switchTab('tab-jurisdiction')" class="cursor-pointer bg-judicial-800/80 hover:bg-judicial-800 border border-slate-600 hover:border-judicial-gold rounded-xl p-3 text-center transition">
                    <div class="text-judicial-gold text-xl mb-1"><i class="fa-solid fa-Scale-unbalanced"></i></div>
                    <h3 class="font-bold text-xs text-white">1. قواعد الاختصاص والتقادم</h3>
                    <p class="text-[10px] text-slate-300 mt-0.5">الاختصاص الولائي ومسقطات الدعوى</p>
                </div>
                <div onclick="switchTab('tab-checklists')" class="cursor-pointer bg-judicial-800/80 hover:bg-judicial-800 border border-slate-600 hover:border-judicial-gold rounded-xl p-3 text-center transition">
                    <div class="text-emerald-400 text-xl mb-1"><i class="fa-solid fa-list-check"></i></div>
                    <h3 class="font-bold text-xs text-white">2. قوائم الفحص والتحقيق</h3>
                    <p class="text-[10px] text-slate-300 mt-0.5">المستندات، الأسئلة، والضوابط الفنية</p>
                </div>
                <div onclick="switchTab('tab-qayds')" class="cursor-pointer bg-judicial-800/80 hover:bg-judicial-800 border border-slate-600 hover:border-judicial-gold rounded-xl p-3 text-center transition">
                    <div class="text-amber-400 text-xl mb-1"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                    <h3 class="font-bold text-xs text-white">3. مولّد القيود والأوصاف</h3>
                    <p class="text-[10px] text-slate-300 mt-0.5">صياغة الوقائع ومواد الإسناد آلياً</p>
                </div>
                <div onclick="switchTab('tab-defenses')" class="cursor-pointer bg-judicial-800/80 hover:bg-judicial-800 border border-slate-600 hover:border-judicial-gold rounded-xl p-3 text-center transition">
                    <div class="text-sky-400 text-xl mb-1"><i class="fa-solid fa-gavel"></i></div>
                    <h3 class="font-bold text-xs text-white">4. الحيثيات والأحكام والدفوع</h3>
                    <p class="text-[10px] text-slate-300 mt-0.5">أحكام الإدارية العليا والردود القياسية</p>
                </div>
                <div onclick="switchTab('tab-regulations')" class="cursor-pointer bg-judicial-800/80 hover:bg-judicial-800 border border-slate-600 hover:border-judicial-gold rounded-xl p-3 text-center transition col-span-2 md:col-span-1">
                    <div class="text-rose-400 text-xl mb-1"><i class="fa-solid fa-book-bookmark"></i></div>
                    <h3 class="font-bold text-xs text-white">5. اللوائح وأوجه التصرف</h3>
                    <p class="text-[10px] text-slate-300 mt-0.5">القرارات التنظيمية وصيغ التصرف</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. شريط التبويبات الخمسة -->
    <div class="max-w-7xl mx-auto px-4 mt-5">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-2 bg-white p-2 rounded-xl shadow-sm border border-slate-200">
            <button onclick="switchTab('tab-jurisdiction')" id="btn-tab-jurisdiction" class="tab-btn tab-active py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition">
                <i class="fa-solid fa-filter"></i>
                <span>1. الاختصاص والتقادم</span>
            </button>
            <button onclick="switchTab('tab-checklists')" id="btn-tab-checklists" class="tab-btn text-slate-600 hover:bg-slate-100 py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition">
                <i class="fa-solid fa-list-check"></i>
                <span>2. قوائم التحقيق</span>
            </button>
            <button onclick="switchTab('tab-qayds')" id="btn-tab-qayds" class="tab-btn text-slate-600 hover:bg-slate-100 py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span>3. مولّد القيود والأوصاف</span>
            </button>
            <button onclick="switchTab('tab-defenses')" id="btn-tab-defenses" class="tab-btn text-slate-600 hover:bg-slate-100 py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition">
                <i class="fa-solid fa-shield-halved"></i>
                <span>4. الحيثيات والأحكام والدفوع</span>
            </button>
            <button onclick="switchTab('tab-regulations')" id="btn-tab-regulations" class="tab-btn text-slate-600 hover:bg-slate-100 py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition col-span-2 md:col-span-1">
                <i class="fa-solid fa-book-open"></i>
                <span>5. اللوائح وأوجه التصرف</span>
            </button>
        </div>
    </div>

    <!-- 5. محتوى الأقسام الخمسة -->
    <main class="max-w-7xl mx-auto px-4 mt-5">

        <!-- ================= القسم الأول: قواعد الاختصاص والتقادم ================= -->
        <section id="tab-jurisdiction" class="tab-content space-y-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-3">
                <div>
                    <h2 class="text-base font-bold text-judicial-900">قواعد الاختصاص الولائي، القيود الإجرائية، ومسقطات الدعوى</h2>
                    <p class="text-xs text-slate-500">مرجع سريع لضوابط الاختصاص، الطلبات والأذون، وأحكام السقوط بالتقادم أو انتهاء الخدمة.</p>
                </div>
                <button onclick="openItemEditor('jurisdiction')" class="admin-add-btn hidden bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-2 rounded-lg text-xs font-bold flex items-center gap-1 shadow">
                    <i class="fa-solid fa-plus"></i> إضافة قاعدة اختصاص / تقادم
                </button>
            </div>
            <div id="jurisdictionContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </section>

        <!-- ================= القسم الثاني: قوائم الفحص والتحقيق ================= -->
        <section id="tab-checklists" class="tab-content hidden space-y-5">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h2 class="text-base font-bold text-judicial-900">قوائم الفحص والأسئلة الاسترشادية (Checklists)</h2>
                    <p class="text-xs text-slate-500">اختر موضوع الواقعة لاستعراض المستندات الواجب ضمها والأسئلة الجوهرية والضوابط الفنية.</p>
                </div>
                <div class="flex items-center gap-2 flex-1 max-w-lg">
                    <select id="checklistSelector" onchange="renderSelectedChecklist()" class="w-full bg-slate-50 border-2 border-judicial-800 text-judicial-900 font-bold rounded-lg px-3 py-2 text-xs focus:outline-none"></select>
                    <button onclick="openItemEditor('checklist')" class="admin-add-btn hidden bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-2 rounded-lg text-xs font-bold whitespace-nowrap shadow">
                        <i class="fa-solid fa-plus"></i> إضافة قائمة
                    </button>
                    <button onclick="editCurrentChecklist()" class="admin-edit-btn hidden bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-2 rounded-lg text-xs" title="تعديل القائمة">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button onclick="deleteCurrentChecklist()" class="admin-del-btn hidden bg-red-600 hover:bg-red-700 text-white px-2.5 py-2 rounded-lg text-xs" title="حذف القائمة">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </div>

            <!-- شريط نسبة الاستيفاء -->
            <div class="bg-white px-4 py-3 rounded-xl shadow-sm border border-slate-200 flex items-center gap-4">
                <span class="text-xs font-bold text-judicial-900 whitespace-nowrap">نسبة استيفاء عناصر الموضوع:</span>
                <div class="w-full bg-slate-200 rounded-full h-2.5">
                    <div id="progressBar" class="bg-judicial-gold h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <span id="progressText" class="text-xs font-bold text-judicial-900">0%</span>
                <button onclick="resetCheckboxes()" class="text-xs text-red-600 hover:underline whitespace-nowrap">تصفير العلامات</button>
            </div>

            <div id="checklistContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-5"></div>
        </section>

        <!-- ================= القسم الثالث: مولّد القيود والأوصاف ================= -->
        <section id="tab-qayds" class="tab-content hidden space-y-5">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-4">
                    <div class="flex justify-between items-center border-b pb-2">
                        <h3 class="font-bold text-judicial-900 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-sliders text-judicial-gold"></i> إعدادات القيد والوصف
                        </h3>
                        <div class="flex gap-1">
                            <button onclick="openItemEditor('qayd')" class="admin-add-btn hidden bg-emerald-600 text-white px-2 py-1 rounded text-[11px] font-bold">+ قالب</button>
                            <button onclick="editCurrentQayd()" class="admin-edit-btn hidden bg-amber-500 text-white px-2 py-1 rounded text-[11px]"><i class="fa-solid fa-pen"></i></button>
                            <button onclick="deleteCurrentQayd()" class="admin-del-btn hidden bg-red-600 text-white px-2 py-1 rounded text-[11px]"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">اختر قالب المخالفة:</label>
                        <select id="qaydSelector" onchange="generateQayd()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-xs font-bold text-judicial-900"></select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">اسم المخالف وصفته ودرجته الوظيفية:</label>
                        <input type="text" id="q_name" oninput="generateQayd()" placeholder="مثال: مهندس التنظيم بالدرجة الثانية بالوحدة المحلية..." class="w-full border border-slate-300 rounded-lg p-2 text-xs">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">الفترة الزمنية / تاريخ الواقعة:</label>
                        <input type="text" id="q_date" oninput="generateQayd()" placeholder="مثال: خلال عامي 2025 / 2026" class="w-full border border-slate-300 rounded-lg p-2 text-xs">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">بيان الواقعة / العقار / الجهة:</label>
                        <input type="text" id="q_property" oninput="generateQayd()" placeholder="مثال: عقار المواطن/ ... الكائن بناحية ..." class="w-full border border-slate-300 rounded-lg p-2 text-xs">
                    </div>
                </div>

                <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-center border-b pb-3 mb-4">
                            <h3 class="font-bold text-judicial-900 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-file-signature text-judicial-gold"></i> النص القانوني الجاهز للنسخ
                            </h3>
                            <span id="qaydSectorBadge" class="bg-judicial-900 text-judicial-gold text-xs font-bold px-2.5 py-0.5 rounded"></span>
                        </div>
                        <div id="qaydOutput" class="bg-slate-50 p-5 rounded-xl border-2 border-dashed border-slate-300 leading-relaxed text-slate-800 font-serif text-lg whitespace-pre-line"></div>
                    </div>

                    <div class="mt-5 flex flex-wrap gap-2 justify-end border-t pt-4">
                        <button onclick="copyText('qaydOutput')" class="bg-judicial-900 hover:bg-judicial-800 text-white font-bold px-4 py-2 rounded-lg text-xs flex items-center gap-1.5 shadow">
                            <i class="fa-regular fa-copy text-judicial-gold"></i> نسخ النص
                        </button>
                        <button onclick="addToBasket('القيد والوصف', document.getElementById('qaydOutput').innerText)" class="bg-judicial-gold hover:bg-yellow-500 text-judicial-950 font-extrabold px-4 py-2 rounded-lg text-xs flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-plus"></i> إضافة للمسودة
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <!-- ================= القسم الرابع: بنك الحيثيات والأحكام والدفوع ================= -->
        <section id="tab-defenses" class="tab-content hidden space-y-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-3">
                <div>
                    <h2 class="text-base font-bold text-judicial-900">موسوعة الحيثيات، أحكام الإدارية العليا، والرد على الدفوع</h2>
                    <p class="text-xs text-slate-500">صياغات قانونية ومبادئ قضائية مفهرسة وجاهزة للنسخ المباشر.</p>
                </div>
                <button onclick="openItemEditor('defense')" class="admin-add-btn hidden bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-2 rounded-lg text-xs font-bold flex items-center gap-1 shadow">
                    <i class="fa-solid fa-plus"></i> إضافة حيثية / حكم / دفع جديد
                </button>
            </div>
            <div id="defensesContainer" class="grid grid-cols-1 gap-4"></div>
        </section>

        <!-- ================= القسم الخامس: اللوائح والقرارات وأوجه التصرف ================= -->
        <section id="tab-regulations" class="tab-content hidden space-y-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-3">
                <div>
                    <h2 class="text-base font-bold text-judicial-900">دليل اللوائح، القرارات الوزارية، وصيغ التصرف النهائي</h2>
